# EPFT - Nalam Academy
# Copy to .env and replace every production secret. Never commit .env.

DB_HOST=localhost
DB_PORT=5432
DB_NAME=epft
DB_USER=postgres
DB_PASSWORD=CHANGE_ME
DB_POOL_MAX=30

PORT=5007
NODE_ENV=development

# Must be 32+ random characters in production
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_32_CHARS_MIN
JWT_EXPIRES_IN=7d

# Comma-separated browser origins allowed to call the API
FRONTEND_URL=http://localhost:5123

# Development-only demo data switches
SEED_DEFAULT_USERS=true
SEED_SAMPLE_DATA=false

# Optional production first-admin bootstrap. Do not use a weak password.
# BOOTSTRAP_ADMIN_EMAIL=admin@example.com
# BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

MAX_FILE_SIZE_MB=500
